# ---- 本机私有：绝不提交 ----
# 定位文件里有 token（首次运行随机生成）和**本机绝对路径**。
# 上传它等于把钥匙和你的目录结构一起公开。
# 注意：它**不是安装的必需输入** —— install.py 在没有它时会自己生成。
dsh_workspace.json
dsh_bridge/dsh_workspace.json

# ---- 用户数据 / 真实图纸 ----
# real/ 放的是真实工程图纸（可能是客户资料），不适合进公开仓库。
# 想放示例图请用**自己画的**或明确授权的图，并放到 examples/ 下。
real/

# ⚠️ 数据目录，不是源码目录 —— **必须写前导斜杠**。
#
# 踩过：这一条原来写成 `cad/`，而 .gitignore 的 `cad/` 会匹配**任何层级**的
# cad 目录，于是 `tools/cad/`（DXF 读图工具的**源码**）被整个忽略了 ——
# dxf_import.py / cad_to_plan.py / dxf_probe.py / dxf_detail.py
# **四个核心文件根本没进仓库**，而本地一切正常，看不出问题。
# 直到我写"模拟全新克隆"的测试才发现。
#
# 前导 `/` 表示"只匹配仓库根目录下的 cad"。
/cad/
# examples/ 下的示例图纸**有意公开**（用户确认有权公开）—— 不要排除
models/*.skp
workspace/            # 若有：用户自己的工作产物

# ---- 运行产物 ----
shots/
flow_out/
degrade_out/
sweep_out/
tests/shots/
tests/flow_out/
tests/degrade_out/
tests/sweep_out/
*.log
bridge.log
boot_check*.skp
*.skp
*.skb
*.bak

