    "rules": [
      { "match": "-门扇$", "name": "木门", "color": [140, 100, 66] },
      { "match": "-玻璃$", "name": "玻璃", "color": [178, 214, 226] },
      { "match": "-框\\d$", "name": "门窗框", "color": [168, 168, 164] },
      { "match": "-上槛$|-下槛$", "name": "门窗框", "color": [168, 168, 164] },
      { "match": "-地面$", "name": "木地板", "color": [186, 140, 92] },
      { "match": "-天花$", "name": "涂料", "color": [250, 250, 248] },
      { "match": "^ROOF", "name": "屋面", "color": [150, 148, 144] },
      { "match": "^ST", "name": "混凝土", "color": [200, 200, 198] },
      { "match": "^F2-", "name": "混凝土", "color": [208, 208, 206] },
      { "match": "^F1-", "name": "混凝土", "color": [200, 200, 198] },
      { "match": "^W-", "name": "砌体", "color": [214, 206, 194] },
      { "match": "^E-", "name": "砌体", "color": [206, 198, 186] }
    ]
  },

